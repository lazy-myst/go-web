# Copy this to /opt/chatapp/backend/.env on the server and fill in real
# values. That file is never committed to git (see .gitignore) — create it
# by hand on the server, chmod 600 it, and never paste real secrets here.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
PORT=3001
JWT_SECRET=<generate one, e.g. `openssl rand -hex 32`>

# Comma-separated origins allowed to call the REST API (gofiber/cors format).
# Since there's no domain yet, this is whatever the frontend is served from —
# e.g. http://<server-ip> if nginx serves it on port 80, or
# http://<server-ip>:5173 if you're running the Vite dev server against prod.
CORS_ORIGINS=http://<server-ip>
